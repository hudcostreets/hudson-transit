// FE on Workers + static Assets (W+A), replacing GitHub Pages
// (see `specs/workers-assets-r2-files.md`). Deploy with `pnpm deploy:worker`,
// which builds `dist/` first; a bare `wrangler deploy` ships whatever `dist/` holds.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hbt-www",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "account_id": "2363642879f18d37d52dca114059937e",
  "workers_dev": true,
  "routes": [
    { "pattern": "hbt.hccs.dev", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get `index.html` with a 200 (GHP serves its `404.html` copy with a 404).
    "not_found_handling": "single-page-application",
    // Only SPA navigation routes hit the Worker (for `<title>` / OG rewriting);
    // hashed `/assets/*` and other static files go to the asset server directly.
    "run_worker_first": ["/", "/nyc", "/nyc/*"],
  },
  "r2_buckets": [
    { "binding": "HBT_BUCKET", "bucket_name": "hbt" },
  ],
  "observability": { "enabled": true },
}
